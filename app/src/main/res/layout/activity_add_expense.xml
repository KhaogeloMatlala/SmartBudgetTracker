<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F5E9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:text="💰 Add Expense"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#0B7A34"
            android:layout_marginBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <EditText
                    android:id="@+id/etDate"
                    android:hint="📅 Date (YYYY-MM-DD)"
                    android:textColor="#000000"
                    android:textColorHint="#999999"
                    android:textSize="15sp"
                    android:padding="14dp"
                    android:background="@drawable/edittext_border"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/etStartTime"
                    android:hint="⏰ Start Time"
                    android:textColor="#000000"
                    android:textColorHint="#999999"
                    android:textSize="15sp"
                    android:padding="14dp"
                    android:background="@drawable/edittext_border"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/etEndTime"
                    android:hint="⏱️ End Time"
                    android:textColor="#000000"
                    android:textColorHint="#999999"
                    android:textSize="15sp"
                    android:padding="14dp"
                    android:background="@drawable/edittext_border"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/etDescription"
                    android:hint="📝 Description"
                    android:textColor="#000000"
                    android:textColorHint="#999999"
                    android:textSize="15sp"
                    android:padding="14dp"
                    android:background="@drawable/edittext_border"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/etCategoryExpense"
                    android:hint="🏷️ Category"
                    android:textColor="#000000"
                    android:textColorHint="#999999"
                    android:textSize="15sp"
                    android:padding="14dp"
                    android:background="@drawable/edittext_border"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/etAmount"
                    android:hint="💵 Amount"
                    android:inputType="numberDecimal"
                    android:textColor="#000000"
                    android:textColorHint="#999999"
                    android:textSize="15sp"
                    android:padding="14dp"
                    android:background="@drawable/edittext_border"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnAddPhoto"
            android:text="📷 Take Photo"
            android:backgroundTint="#1E88E5"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnChooseGallery"
            android:text="🖼️ Choose from Gallery"
            android:backgroundTint="#00897B"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/imgExpensePhoto"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="15dp"
            android:background="#FFFFFF"
            android:scaleType="centerCrop" />

        <Button
            android:id="@+id/btnSaveExpense"
            android:text="💾 Save Expense"
            android:backgroundTint="#0B7A34"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>